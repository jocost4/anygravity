[Unit]
Description=Anygravity - Ultra-lightweight Antigravity Provider Pipe for Any AI Agent
After=network.target

[Service]
Type=exec
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Set HOST to bind additional addresses (e.g., 127.0.0.1,tailscale or 127.0.0.1,lan or 0.0.0.0)
Environment=HOST=127.0.0.1
Environment=PORT=20130
WorkingDirectory=%h
ExecStart=%h/.local/bin/anygravity
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM

# Hardened sandbox / resource constraints
LimitNOFILE=65536
MemoryMax=64M

[Install]
WantedBy=default.target
