[Unit]
Description=Anygravity - Ultra-lightweight Antigravity Provider Pipe for Any AI Agent
After=network.target

[Service]
Type=exec
# NOTE: Set to your actual username and home directory if installing manually without install.sh.
# Alternatively, use: sudo systemctl enable --now anygravity@<your-user>.service
# Or for rootless/user mode: systemctl --user enable --now anygravity.service
User=%i
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PORT=20130
WorkingDirectory=%h
ExecStart=/usr/local/bin/anygravity
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM

# Hardened sandbox / resource constraints
LimitNOFILE=65536
MemoryMax=64M

[Install]
WantedBy=multi-user.target
